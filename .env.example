# 本番サイトのURL（OGP・sitemap・認証メールのリダイレクト用）
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# 管理画面パスワード（URLを知っている人だけが更新可能）
ADMIN_PASSWORD=your-strong-password-here

# Supabase（無料）— 本番で管理画面から保存するために必要
# https://supabase.com でプロジェクト作成 → Settings → API から取得
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 会員ログイン（Supabase Auth）— 公開キー（anon / publishable）
# Dashboard → Authentication → Providers で Email を有効化
# Dashboard → Authentication → URL Configuration:
#   Site URL = NEXT_PUBLIC_SITE_URL
#   Redirect URLs に以下を追加:
#     {NEXT_PUBLIC_SITE_URL}/auth/callback
#     http://localhost:3000/auth/callback  （ローカル開発用）
# Confirm email を ON にすると、新規登録後に確認メールが送信されます
# 本番で確認メールを送るには Supabase → Authentication → Emails → SMTP Settings で
# Resend 等のカスタム SMTP を設定（Host: smtp.resend.com / Port: 465 / User: resend / Pass: APIキー）
# Sender email は Resend で Verified なドメインのアドレス（例: no-reply@your-domain.com）
# ガチャ当選シリアル管理 — scripts/supabase-gacha-serials.sql を SQL Editor で実行
# 運営DM — scripts/supabase-dm.sql を SQL Editor で実行
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ローカル開発（npm run dev）のみ — Supabase 未設定でも試せるページ
# /login/dev  →  /profile/dev  （localStorage、本番ビルドでは 404）
# /gacha/dev  — 回数制限なし・均等確率のガチャ試験（本番ビルドでは 404）
