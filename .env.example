# 本番サイトのURL（OGP・sitemap・認証メールのリダイレクト用）
# Vercel では本番ドメインを必ず設定（未設定だと認証メールのリンクが localhost になる）
NEXT_PUBLIC_SITE_URL=https://chuchoter-official.com

# 管理画面パスワード（URLを知っている人だけが更新可能）
ADMIN_PASSWORD=your-strong-password-here

# サイト全体の非公開ロック（production ビルドはデフォルトで非公開）
# ※ Vercel に SITE_PRIVATE=false が残っていると公開のままになります
# 再公開: SITE_PRIVATE=false → Redeploy
# 関係者だけ見る: SITE_PASSWORD を設定（ブラウザの Basic 認証）→ Redeploy
# SITE_PRIVATE=false
# SITE_PASSWORD=your-site-access-password

# Supabase（無料）— 本番で管理画面から保存するために必要
# https://supabase.com でプロジェクト作成 → Settings → API から取得
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 会員ログイン（Supabase Auth）— 公開キー（anon / publishable）
# Dashboard → Authentication → Providers で Email を有効化
# Dashboard → Authentication → URL Configuration:
#   Site URL = NEXT_PUBLIC_SITE_URL
#   Redirect URLs に以下を追加:
#     {NEXT_PUBLIC_SITE_URL}/auth/callback
#     http://localhost:3000/auth/callback  （ローカル開発用）
# Confirm email を ON にすると、新規登録後に確認メールが送信されます
# メール本文のデザイン: scripts/supabase-auth-emails/ の HTML を Dashboard に貼り付け
# 本番で確認メールを送るには Supabase → Authentication → Emails → SMTP Settings で
# Resend 等のカスタム SMTP を設定（Host: smtp.resend.com / Port: 465 / User: resend / Pass: APIキー）
# Sender email は Resend で Verified なドメインのアドレス（例: no-reply@your-domain.com）
# ガチャ当選シリアル管理 — scripts/supabase-gacha-serials.sql を SQL Editor で実行
# Vercel Cron（プッシュ通知リマインダー）— 本番で CRON_SECRET を設定（ランダムな長い文字列）
# CRON_SECRET=your-random-secret-here
# 運営DM — scripts/supabase-dm.sql を SQL Editor で実行
# シュシュテポイント（CP）・デイリータスク — scripts/supabase-cp.sql を SQL Editor で実行
# ボーナスルーレット — scripts/supabase-bonus-roulette.sql を SQL Editor で実行
# ウェブプッシュ — scripts/supabase-push-notifications.sql を SQL Editor で実行
# VAPID 鍵生成: node scripts/generate-vapid-keys.mjs
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:no-reply@your-domain.com
# Discord 通知（任意）— 管理画面 DM タブでも設定可。環境変数で上書き可能
# DISCORD_DM_WEBHOOK_URL=https://discord.com/api/webhooks/...
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ローカル開発（npm run dev）のみ — Supabase 未設定でも試せるページ
# /login/dev  →  /profile/dev  （localStorage、本番ビルドでは 404）
# /gacha/dev  — 回数制限なし・均等確率のガチャ試験（本番ビルドでは 404）

# Google Tag Manager（任意）— 本番のみ読み込み（未設定なら無効）
# https://tagmanager.google.com/ → コンテナ ID（GTM-XXXXXXXX）
# GA4 は GTM 管理画面のタグで設定（サイト側に G- ID は不要）
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXXX

# Google Search Console 所有権確認（任意）
# 管理画面で取得した verification コードを設定
# GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google AdSense（任意）— 本番のみ読み込み（管理画面 /admin は除外）
# NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx

# 旧: 直接 GA4 埋め込み（GTM 利用時は使わない）
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
